namespace                = "kafka"
statefulset_name          = "kafka"
controller_quorum_voters = "100@kafka-controller-0.kafka-controller.kafka.svc.cluster.local:9093,101@kafka-controller-1.kafka-controller.kafka.svc.cluster.local:9093,102@kafka-controller-2.kafka-controller.kafka.svc.cluster.local:9093"
storage_class_name        = "standard"

